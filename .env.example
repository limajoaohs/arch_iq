# AWS Configuration
AWS_REGION=us-east-1
# Bedrock Model (e.g. amazon.nova-lite-v1:0, amazon.nova-micro-v1:0, anthropic.claude-3-5-sonnet-20240620-v1:0)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# Bedrock Knowledge Bases (RAG gerenciado pela AWS) - opcional
BEDROCK_KB_ID=

# Storage & Persistence
CHROMA_PERSIST_DIR=./chroma_data
# S3_REPORTS_BUCKET=
# DYNAMODB_TABLE_NAME=

# SNS - alertas quando score de arquitetura está baixo (opcional)
# Exemplo: arn:aws:sns:us-east-1:123456789012:arch-iq-alerts
SNS_TOPIC_ARN=

# Cognito - autenticação de usuários (opcional; se vazio, a API fica aberta)
# O User Pool precisa estar na mesma AWS_REGION. Preencha também web/config.js (cognito.domain/clientId).
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=

# CORS - origens permitidas, separadas por virgula (padrao: *)
# CORS_ORIGINS=https://limajoaohs.github.io,http://localhost:8000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
